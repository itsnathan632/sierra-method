description <https://fireforce6.github.io/mission-control/system-analysis/connections#> as connections {

	extends <https://fireforce6.github.io/mission-control/system-analysis/components#> as components

	uses <https://www.modelware.io/sierra/component#> as component

    ref instance components:FireSat [
        component:hasPort FireSat.Command_In
        component:hasPort FireSat.Telemetry_Out
    ]
    instance FireSat.Command_In : component:Port [ component:direction "In" ]
    instance FireSat.Telemetry_Out : component:Port [ component:direction "Out" ]

    ref instance components:Payload [
        component:hasPort Payload.Data_Out
        component:hasPort Payload.Power_In
    ]
    instance Payload.Data_Out : component:Port [ component:direction "Out" ]
    instance Payload.Power_In : component:Port [ component:direction "In" ]

    ref instance components:Platform [
        component:hasPort Platform.Data_In
        component:hasPort Platform.Data_Out
        component:hasPort Platform.Power_Out
        component:hasPort Platform.Command_In
    ]
    instance Platform.Data_In : component:Port [ component:direction "In" ]
    instance Platform.Data_Out : component:Port [ component:direction "Out" ]
    instance Platform.Power_Out : component:Port [ component:direction "Out" ]
    instance Platform.Command_In : component:Port [ component:direction "In" ]

    ref instance components:PropulsionSegment [
        component:hasPort Propulsion.Command_In
        component:hasPort Propulsion.Power_In
    ]
    instance Propulsion.Command_In : component:Port [ component:direction "In" ]
    instance Propulsion.Power_In : component:Port [ component:direction "In" ]

    ref instance components:ImageBuffer [
        component:hasPort ImageBuffer.Data_In
        component:hasPort ImageBuffer.Data_Out
    ]
    instance ImageBuffer.Data_In : component:Port [ component:direction "In" ]
    instance ImageBuffer.Data_Out : component:Port [ component:direction "Out" ]

    ref instance components:DataFormatter [
        component:hasPort DataFormatter.Data_In
        component:hasPort DataFormatter.Data_Out
    ]
    instance DataFormatter.Data_In : component:Port [ component:direction "In" ]
    instance DataFormatter.Data_Out : component:Port [ component:direction "Out" ]

    ref instance components:EmergencyDataRelay [
        component:hasPort EmergencyDataRelay.Data_In
        component:hasPort EmergencyDataRelay.Emergency_Data_Out
    ]
    instance EmergencyDataRelay.Data_In : component:Port [ component:direction "In" ]
    instance EmergencyDataRelay.Emergency_Data_Out : component:Port [ component:direction "Out" ]

    instance TelemetrySignal : component:Signal []
    instance CommandSignal : component:Signal []
    instance ElectricalPower : component:Energy []

    relation instance Conn_FireSatCmd_to_Platform : component:Connection [
        from FireSat.Command_In
        to Platform.Command_In
        component:transfers CommandSignal
    ]

    relation instance Conn_PlatformPower_to_Payload : component:Connection [
        from Platform.Power_Out
        to Payload.Power_In
        component:transfers ElectricalPower
    ]

    relation instance Conn_PlatformPower_to_Propulsion : component:Connection [
        from Platform.Power_Out
        to Propulsion.Power_In
        component:transfers ElectricalPower
    ]

    relation instance Conn_Payload_to_Platform : component:Connection [
        from Payload.Data_Out
        to Platform.Data_In
        component:transfers TelemetrySignal
    ]

    relation instance Conn_Platform_to_FireSatTelem : component:Connection [
        from Platform.Data_Out
        to FireSat.Telemetry_Out
        component:transfers TelemetrySignal
    ]

    relation instance Conn_ImageBuffer_to_DataFormatter : component:Connection [
        from ImageBuffer.Data_Out
        to DataFormatter.Data_In
        component:transfers TelemetrySignal
    ]

    relation instance Conn_DataFormatter_to_EmergencyDataRelay : component:Connection [
        from DataFormatter.Data_Out
        to EmergencyDataRelay.Data_In
        component:transfers TelemetrySignal
    ]

}
